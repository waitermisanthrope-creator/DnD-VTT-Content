{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DnD-VTT content package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "author",
    "type",
    "license",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "enum": [
        "game-system",
        "race",
        "class",
        "spell",
        "craft",
        "map",
        "model",
        "appearance",
        "collection"
      ]
    },
    "gameSystemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\\\\\)[a-zA-Z0-9_./-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
