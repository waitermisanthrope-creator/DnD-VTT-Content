{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic mod collection metadata for Unity10036+",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "type",
    "collectionCategory",
    "members"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "const": "collection"
    },
    "collectionCategory": {
      "enum": [
        "races",
        "classes",
        "feats",
        "icons",
        "wallpapers",
        "dice",
        "dice-trays",
        "maps",
        "models",
        "surfaces"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
      }
    }
  }
}
